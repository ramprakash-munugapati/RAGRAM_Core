# ---- PostgreSQL connection ----
RAGRAM_PG_HOST=localhost
RAGRAM_PG_PORT=5432
RAGRAM_PG_USER=postgres
RAGRAM_PG_PASSWORD=change-me
RAGRAM_PG_DBNAME=ragram

# ---- Embedding provider ----
# "openai" or "huggingface"
RAGRAM_EMBEDDING_PROVIDER=openai
# OpenAI: text-embedding-3-small (1536) | HuggingFace: sentence-transformers/all-MiniLM-L6-v2 (384)
RAGRAM_EMBEDDING_MODEL=text-embedding-3-small
# MUST match the model output size above.
RAGRAM_EMBEDDING_DIM=1536

# ---- LLM synthesis ----
RAGRAM_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-key-here

# ---- Chunking / retrieval ----
RAGRAM_CHUNK_SIZE=900
RAGRAM_CHUNK_OVERLAP=150
RAGRAM_TOP_K=5
# Cosine-distance cutoff (0 = identical .. 2 = opposite). Set to "none" to disable.
RAGRAM_MAX_DISTANCE=0.5
